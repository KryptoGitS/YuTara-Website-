{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Open YuTara in Chrome (localhost:8080)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:8080/index.html",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "Open index.html Directly (No Server)",
      "type": "chrome",
      "request": "launch",
      "file": "${workspaceFolder}/index.html"
    }
  ]
}
